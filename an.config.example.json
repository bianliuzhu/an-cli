{
	"saveTypeFolderPath": "apps/types",
	"saveApiListFolderPath": "apps/apis/",
	"saveEnumFolderPath": "apps/enums",
	"importEnumPath": "../../enums",
	"requestMethodsImportPath": "./config/fetch",
	"_comment_requestTemplate": "请求模板：axios | fetch | wx | uniapp | taro，默认 axios。切换后需删除 <saveApiListFolderPath>/config 目录再次生成",
	"requestTemplate": "axios",
	"formatting": {
		"indentation": "\t",
		"lineEnding": "\n"
	},
	"headers": {},
	"enmuConfig": {
		"erasableSyntaxOnly": false,
		"varnames": "enum-varnames",
		"comment": "enum-descriptions"
	},
	"_comment_logLevel": "终端日志输出级别：silent-无输出, error-仅错误, warn-警告+错误, info(默认)-常规信息, verbose-详细输出",
	"logLevel": "info",
	"swaggerConfig": [
		{
			"url": "./data/op.json",
			"apiListFileName": "op.ts",
			"stripPathPrefix": "/forward",
			"headers": {},
			"includeInterface": [],
			"excludeInterface": [],
			"dataLevel": "serve",
			"parameterSeparator": "_",
			"_comment": "剔除响应模型示例：将 ResultMessageBoolean 转换为 boolean",
			"responseModelTransform": {
				"type": "unwrap",
				"dataField": "data"
			}
		},
		{
			"url": "./data/df.json",
			"apiListFileName": "df.ts",
			"stripPathPrefix": "/api",
			"requestPathPrefix": "",
			"mockPathPrefix": "/api",
			"headers": {},
			"includeInterface": [],
			"excludeInterface": [],
			"dataLevel": "serve",
			"parameterSeparator": "_",
			"_comment": "添加响应模型示例：为没有响应模型的接口添加包装",
			"responseModelTransform": {
				"type": "wrap",
				"dataField": "data",
				"wrapperFields": {
					"success": "boolean",
					"code": "number",
					"message": "string",
					"data": "T"
				}
			}
		},
		{
			"url": "./data/sau.json",
			"apiListFileName": "sau.ts",
			"stripPathPrefix": "/api",
			"headers": {},
			"includeInterface": [],
			"excludeInterface": [],
			"dataLevel": "serve",
			"parameterSeparator": "_",
			"_comment": "不使用响应模型转换，保持原样"
		}
	],
	"_documentation": {
		"stripPathPrefix": {
			"description": "从 OpenAPI 路径开头移除的前缀，按完整路径段匹配；同时影响函数名、类型名、文件名和请求路径。服务级配置优先于全局默认值。",
			"example": "/api/v1",
			"result": "/api/v1/users -> /users"
		},
		"requestPathPrefix": {
			"description": "添加到裁剪后的请求路径前，不影响生成名称；服务级配置优先于全局默认值。不去重路径段。",
			"example": "/gateway",
			"result": "/users -> /gateway/users"
		},
		"mockPathPrefix": {
			"description": "swaggerConfig 服务级配置，仅 anl mock 使用。在生成 API 的实际路径前追加前缀，自动处理首尾斜杠，不去重路径段；未配置或空字符串时保持原路径。已有 mock 需 --overwrite 才更新。",
			"example": "/api",
			"result": "/lark/im/messages/refund -> /api/lark/im/messages/refund"
		},
		"logLevel": {
			"description": "终端日志输出级别，控制 swagger-codegen 在终端的信息输出量",
			"values": {
				"silent": "无任何输出",
				"error": "仅显示错误信息",
				"warn": "显示警告和错误信息",
				"info": "（默认）显示常规信息，包括成功提示、警告和错误",
				"verbose": "显示所有详细信息，包括每个文件的写入状态、请求详情等"
			}
		},
		"responseModelTransform": {
			"description": "响应模型转换配置，支持三种转换类型",
			"types": {
				"unwrap": {
					"description": "剔除响应模型，提取指定字段（默认为 data 字段）",
					"example": {
						"type": "unwrap",
						"dataField": "data"
					},
					"result": "ResultMessageBoolean -> boolean, ResultMessageIPageRefundOrderQueryVO -> IPageRefundOrderQueryVO"
				},
				"wrap": {
					"description": "添加响应模型，将原类型包装到指定字段中",
					"example": {
						"type": "wrap",
						"dataField": "data",
						"wrapperFields": {
							"success": "boolean",
							"code": "number",
							"message": "string",
							"data": "T"
						}
					},
					"result": "UsersEntityDto -> { success?: boolean; code?: number; message?: string; data?: UsersEntityDto }"
				},
				"replace": {
					"description": "替换响应模型为指定类型",
					"example": {
						"type": "replace",
						"wrapperType": "ResponseModel<T>"
					},
					"result": "任何类型 -> ResponseModel<T>"
				}
			}
		}
	}
}